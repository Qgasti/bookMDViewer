{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-note",
  "description": "Capability for the quick-note window",
  "windows": ["quick-note"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-always-on-top",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
